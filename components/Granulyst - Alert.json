    {
      "parameters": {
        "jsCode": "// Pull all tech stack rows (now each has a user link)\nconst techStackItems = $('tech_stack').all();\n\n// Group techs by user\nconst userTechMap = {};\ntechStackItems.forEach(item => {\n  const userId = item.json.fields.user?.[0];\n  const tech = (item.json.fields.tech || '').toLowerCase().trim();\n  if (!userId || !tech) return;\n  if (!userTechMap[userId]) userTechMap[userId] = [];\n  userTechMap[userId].push(tech);\n});\n\n// Current vulnerability\nconst vuln = $input.item.json;\nconst affectedTechs = (vuln.fields.affected_tech || '')\n  .split(',')\n  .map(t => t.toLowerCase().trim())\n  .filter(t => t.length > 0);\n\n// Emit one item per (vuln, user) match\nconst results = [];\nfor (const [userId, userTechs] of Object.entries(userTechMap)) {\n  const matches = affectedTechs.filter(t => userTechs.includes(t));\n  if (matches.length > 0) {\n    results.push({\n      json: {\n        vulnerability_id: vuln.id,\n        cve_id: vuln.fields.cve_id,\n        severity: vuln.fields.severity,\n        user_id: userId,\n        matched_technologies: matches.join(', '),\n        has_match: true\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        128
      ],
