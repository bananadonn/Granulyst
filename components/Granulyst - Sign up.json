    {
      "parameters": {
        "jsCode": "const userId = $input.item.json.id;\nconst techListRaw = $('Webhook').item.json.body.tech_list || '';\n\nconst techs = techListRaw\n  .split(',')\n  .map(t => t.trim().toLowerCase())\n  .filter(t => t.length > 0);\n\nreturn techs.map(tech => ({\n  json: { technology: tech, user_id: userId }\n}));"
      },
